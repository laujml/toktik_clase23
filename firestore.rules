rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /videos/{videoId} {
      function isOwner() {
        return signedIn() && resource.data.uid == request.auth.uid;
      }

      function likePath() {
        return /databases/$(database)/documents/videos/$(videoId)/likes/$(request.auth.uid);
      }

      function likeCounterOnly() {
        return signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes is int
          && request.resource.data.likes >= 0
          && request.resource.data.uid == resource.data.uid
          && (
            (
              request.resource.data.likes == resource.data.likes + 1
              && !exists(likePath())
              && existsAfter(likePath())
            )
            || (
              request.resource.data.likes == resource.data.likes - 1
              && exists(likePath())
              && !existsAfter(likePath())
            )
          );
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == videoId
        && request.resource.data.likes == 0
        && request.resource.data.views == 0
        && request.resource.data.caption is string
        && request.resource.data.caption.size() > 0
        && request.resource.data.caption.size() <= 150
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'id',
          'uid',
          'authorName',
          'caption',
          'videoUrl',
          'likes',
          'views',
          'createdAt'
        ]);

      allow update: if (
        isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.videoUrl == resource.data.videoUrl
        && request.resource.data.likes == resource.data.likes
        && request.resource.data.views == resource.data.views
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['caption', 'authorName'])
      ) || likeCounterOnly();

      allow delete: if isOwner();

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == likeUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
        allow delete: if signedIn() && request.auth.uid == likeUid;
        allow update: if false;
      }
    }
  }
}
